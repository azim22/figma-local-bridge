{
  "name": "figma-local-bridge",
  "version": "0.1.0",
  "description": "A local, authenticated MCP bridge to an editable Figma Design file.",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --test",
    "start": "node server.mjs",
    "status": "node cli.mjs status",
    "stop": "node cli.mjs stop",
    "bridge": "node bridge.mjs --daemon"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ws": "8.21.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.138.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.3"
  }
}
